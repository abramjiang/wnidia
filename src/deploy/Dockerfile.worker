# syntax=docker/dockerfile:1
# WNIDIA Worker 镜像：注册/心跳/执行；可 mock，可代理配对的 vLLM 引擎。
# 构建上下文为仓库根目录。
FROM python:3.12-slim AS runtime

WORKDIR /app

COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

COPY worker ./worker

RUN useradd -m appuser && chown -R appuser /app
USER appuser

EXPOSE 8100

HEALTHCHECK --interval=15s --timeout=4s --start-period=6s --retries=3 \
    CMD python -c "import urllib.request;urllib.request.urlopen('http://127.0.0.1:8100/healthz')" || exit 1

# 容器内统一端口 8100；角色/档位由 compose 注入环境变量
CMD ["python", "-m", "worker.agent"]
